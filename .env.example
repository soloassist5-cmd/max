# Токен бота — выдаётся в MAX при создании бота (раздел «Чат-боты» → нужный бот → ⋮ → Настройки)
MAX_BOT_TOKEN=

# polling — для разработки и тестов, webhook — для боевого сервера
MAX_MODE=polling

# Обязателен, если MAX_MODE=webhook. Только https, MAX не примет http
MAX_WEBHOOK_URL=
MAX_WEBHOOK_HOST=0.0.0.0
MAX_WEBHOOK_PORT=8080
MAX_WEBHOOK_PATH=/max/webhook

# Путь к файлу базы данных SQLite
MAX_DB_PATH=school_bot.db

# Путь к сертификату Минцифры, если он не установлен в системное хранилище
# (см. https://dev.max.ru — «добавьте сертификат Минцифры в список доверенных»)
MAX_CA_BUNDLE=

# Часовой пояс по умолчанию для новых чатов (смещение от UTC)
MAX_TZ_OFFSET=3

# Время утреннего и вечернего дайджеста по умолчанию (можно переопределить командой /timezone для часового пояса чата)
MAX_MORNING_DIGEST=07:30
MAX_EVENING_DIGEST=20:00

# Включены ли дайджесты и напоминания о контрольных вообще
MAX_REMINDERS=true

# --- ИИ-помощник на GigaChat ---
# Ключ авторизации из личного кабинета GigaChat API (Authorization key).
# Это base64 от "Client ID:Client Secret". Без него ИИ-раздел просто отключается.
GIGACHAT_AUTH_KEY=

# GIGACHAT_API_PERS — физлица, GIGACHAT_API_B2B и GIGACHAT_API_CORP — ИП и юрлица
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# GigaChat, GigaChat-2-Pro, GigaChat-2-Max
GIGACHAT_MODEL=GigaChat

# Сертификат Минцифры для обращений к GigaChat.
# Если не задан, берётся значение MAX_CA_BUNDLE
GIGACHAT_CA_BUNDLE=

# Отключать проверку сертификата стоит только для локальных экспериментов
GIGACHAT_VERIFY_SSL=true
